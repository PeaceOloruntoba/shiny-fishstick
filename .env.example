NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may still use an anon key. The app accepts either public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep the service role key server-only. Do not expose it through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
